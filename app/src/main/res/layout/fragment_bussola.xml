<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.pontevi.aquito.ui.bussola.BussolaView
        android:id="@+id/bussola_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt_status_conexao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: desconectado"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#CCCCCC" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apelido" />

            <EditText
                android:id="@+id/input_apelido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Seu apelido"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chave da sala" />

            <EditText
                android:id="@+id/input_chave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ex: ABC123"
                android:inputType="text" />

            <Button
                android:id="@+id/btn_entrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Entrar na sala" />

            <Button
                android:id="@+id/btn_sair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sair da sala" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#CCCCCC" />

            <TextView
                android:id="@+id/txt_sala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sala: —" />

            <TextView
                android:id="@+id/txt_membros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Na sala: —" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#CCCCCC" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eventos:" />

            <TextView
                android:id="@+id/txt_eventos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="—" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#CCCCCC" />

            <Button
                android:id="@+id/btn_enviar_localizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enviar localização" />

            <TextView
                android:id="@+id/txt_ultima_localizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Última localização recebida: —" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>